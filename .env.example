NAFINITY_PORT=8088
NAFINITY_HTTPS_PORT=443
NAF_SOURCE_ROOT=../nafphp
NAFINITY_DB_PASSWORD=replace-with-a-local-password
NAFINITY_DB_ROOT_PASSWORD=replace-with-a-different-local-password
NAFINITY_MAIL_FROM=notifications@example.test
NAFINITY_MAILPIT_PORT=8025

# Where naf/board is checked out, for as long as it is not on Packagist. The
# default assumes it sits beside this project; bin/generate-dev-manifest.py turns
# it into the path repository that composer.dev.json installs from.
NAF_BOARD_ROOT=../board
