NAFINITY_PORT=8088
NAFINITY_HTTPS_PORT=443
NAFINITY_DB_PASSWORD=replace-with-a-local-password
NAFINITY_DB_ROOT_PASSWORD=replace-with-a-different-local-password
NAFINITY_MAIL_FROM=notifications@example.test
NAFINITY_MAILPIT_PORT=8025

# Shared account for system mail and Mail-to-Ticket, configured in app/src/config.php.
# Login defaults to MAIL_FROM. SMTP and IMAP inherit this password; use protocol
# overrides only when the provider issues different credentials.
NAFINITY_MAIL_PASSWORD=
#NAFINITY_MAIL_USER=support@example.com
#NAFINITY_MAIL_REPLY_TO=support@example.com
# Normal project notifications and emailed invitations; security mail is separate.
NAFINITY_MAIL_ENABLED=false

# Outgoing mail goes directly through naf/mail in PHP. Empty HOST uses Mailpit.
# External servers default to STARTTLS/587; port 465 selects implicit TLS.
NAFINITY_SMTP_HOST=
#NAFINITY_SMTP_PORT=465
#NAFINITY_SMTP_SECURITY=auto
#NAFINITY_SMTP_AUTH=auto
#NAFINITY_SMTP_USER=different-smtp-login
#NAFINITY_SMTP_PASSWORD=different-smtp-password
#NAFINITY_SMTP_CA_FILE=/var/www/storage/provider-ca.pem
# Apply environment changes with make run. See docker/mail/smtp.env.example
# for domain setup. PHP settings and mail templates need no image rebuild.

# Mail-to-Ticket: existing mailbox, known case numbers and matching senders only.
# Add an active Nafinity account to each project with read/comment permission.
# Set the ticket's "Anfragende E-Mail-Adresse" to send its public case reference.
NAFINITY_IMAP_ENABLED=false
NAFINITY_IMAP_HOST=
NAFINITY_MAIL_ACTOR=
# TLS/993 by default; STARTTLS selects 143 automatically.
#NAFINITY_IMAP_SECURITY=starttls
#NAFINITY_IMAP_PORT=993
#NAFINITY_IMAP_FOLDER=INBOX
#NAFINITY_IMAP_AUTH=password
#NAFINITY_IMAP_USER=different-mailbox-login
#NAFINITY_IMAP_PASSWORD=different-mailbox-password
#NAFINITY_IMAP_CA_FILE=/var/www/storage/provider-ca.pem

# Live updates over naf/websocket. Off unless set here. The key signs the
# connect tokens and the server refuses to start without one:
#   openssl rand -hex 32
NAFINITY_WEBSOCKET_ENABLED=false
NAFINITY_WEBSOCKET_KEY=
NAFINITY_WEBSOCKET_URL=wss://localhost:8091
NAFINITY_WEBSOCKET_PORT=8091

# Only for developing the NAF packages themselves: their working copies under
# NAF_SOURCE_ROOT are mounted and installed as symlinks instead of the releases.
# bin/init-env switches this on when it finds them beside this project.
#COMPOSE_FILE=compose.yaml:compose.dev.yaml
#NAF_SOURCE_ROOT=../nafphp
