NAFINITY_PORT=8088
NAFINITY_HTTPS_PORT=443
NAFINITY_DB_PASSWORD=replace-with-a-local-password
NAFINITY_DB_ROOT_PASSWORD=replace-with-a-different-local-password
NAFINITY_MAIL_FROM=notifications@example.test
NAFINITY_MAILPIT_PORT=8025

# Live updates over naf/websocket. Off unless set here. The key signs the
# connect tokens and the server refuses to start without one:
#   openssl rand -hex 32
NAFINITY_WEBSOCKET_ENABLED=false
NAFINITY_WEBSOCKET_KEY=
NAFINITY_WEBSOCKET_URL=wss://localhost:8091
NAFINITY_WEBSOCKET_PORT=8091

# Only for developing the NAF packages themselves: their working copies under
# NAF_SOURCE_ROOT are mounted and installed as symlinks instead of the releases.
# bin/init-env switches this on when it finds them beside this project.
#COMPOSE_FILE=compose.yaml:compose.dev.yaml
#NAF_SOURCE_ROOT=../nafphp
