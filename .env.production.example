# Copy to .env.production (private); run Compose with --env-file .env.production
# and -f compose.production.yaml. See the central Nafinity deployment guide.
# Choose a tested release tag or sha256 digest; `main` is for staging.
NAFINITY_IMAGE=ghcr.io/nafphp/nafinity:REPLACE_WITH_RELEASE
NAFINITY_APP_URL=https://tickets.example.com
NAFINITY_HTTP_BIND=0.0.0.0:80
NAFINITY_HTTPS_BIND=0.0.0.0:443
NAFINITY_TLS_DIR=./deploy/tls
NAFINITY_DB_PASSWORD=replace-with-a-long-random-password
NAFINITY_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# SMTP is needed for invitations and account security messages.
NAFINITY_MAIL_FROM=support@example.com
NAFINITY_MAIL_REPLY_TO=support@example.com
NAFINITY_MAIL_USER=support@example.com
NAFINITY_MAIL_PASSWORD=
NAFINITY_MAIL_ENABLED=false
NAFINITY_SMTP_HOST=smtp.example.com
NAFINITY_SMTP_PORT=587
NAFINITY_SMTP_SECURITY=starttls
NAFINITY_SMTP_AUTH=auto

NAFINITY_IMAP_ENABLED=false
NAFINITY_IMAP_HOST=
NAFINITY_IMAP_USER=
NAFINITY_IMAP_PASSWORD=
NAFINITY_MAIL_ACTOR=
