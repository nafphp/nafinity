# The application's own environment. NAF reads this file from BASE_PATH, and
# .env.local instead of it when that exists.
#
# It only fills gaps: a variable already set in the environment wins, so Compose
# decides in development and this file matters where there is no Compose -- a
# bare PHP-FPM, a CI job, someone running the CLI by hand.

# dev and test enable the demo seed and other conveniences; anything else is
# treated as production. The test services set test themselves, so leave this at
# dev even while working on the suite.
APP_ENV=dev

# How the application reaches its database. In development Compose supplies all
# of these; uncomment them only for a deployment that has no Compose, and note
# that DB_HOST is a host name on that network, not 127.0.0.1 inside a container.
#DB_DRIVER=mysql
#DB_HOST=db
#DB_PORT=3306
#DB_DATABASE=nafinity
#DB_USERNAME=nafinity
#DB_PASSWORD=

# Where the application believes it lives. Links in mail are built from it.
#APP_URL=https://localhost

# The sender address for notifications, used when mail is enabled in config.
#NAFINITY_MAIL_FROM=notifications@example.test
