<?php

/**
 * A template of this installation's own.
 *
 * It lives in src/views/, which wins over a template of the same name in
 * naf/board -- copy one of theirs here to change it, keeping the path.
 *
 * @var string $title
 * @var string $file
 */

use function Naf\Board\template;
use function Naf\View\s;

// A page says which layout it sits in, and hands it the page's markup as the
// content block; the renderer supplies what that layout needs but does not
// choose it. Without the layout the page comes out as a bare fragment with no
// navigation and no stylesheets -- which is what a partial wants, and not what
// a page does. Without the block the layout has nothing to put in its <main>.
$this->setLayout(template('layout'));
$this->block('content');

?>
<section class="page-heading">
    <div>
        <h1><?= s($title) ?></h1>
        <p>
            This page is served by your own controller, rendered inside the
            application shell. It comes from <code><?= s($file) ?></code>.
        </p>
    </div>
</section>
<?php $this->endblock('content'); ?>
