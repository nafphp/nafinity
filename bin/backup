#!/bin/sh
set -eu
umask 077
cd "$(dirname "$0")/.."
backup_dir="${1:-work/backups/$(date -u +%Y%m%dT%H%M%SZ)}"
mkdir -p "$backup_dir"
backup_dir=$(cd "$backup_dir" && pwd)
case "$backup_dir" in
    "$(pwd)/app/public"*)
        echo 'Backup destination cannot be public.' >&2
        exit 2
        ;;
esac

# Pause only this Compose project's writers while taking the matching DB/files snapshot.
writer_ids=$(docker compose ps -q app candidate)
resume_writers() {
    if [ -n "$writer_ids" ]; then
        docker unpause $writer_ids >/dev/null
    fi
}

trap resume_writers EXIT
trap 'exit 1' HUP INT TERM
if [ -n "$writer_ids" ]; then
    docker pause $writer_ids >/dev/null
fi

docker compose exec -T db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb-dump -uroot --single-transaction --quick --hex-blob nafinity' > "$backup_dir/database.sql"
tar -czf "$backup_dir/storage.tar.gz" -C app storage
# A digest per part, so a restore can tell a truncated copy from a whole one.
node -e '
const { createHash } = require("node:crypto");
const { readFileSync, writeFileSync } = require("node:fs");
const { join } = require("node:path");
const root = process.argv[1];
const digest = (name) => createHash("sha256").update(readFileSync(join(root, name))).digest("hex");
const manifest = Object.fromEntries(["database.sql", "storage.tar.gz"].map((n) => [n, digest(n)]));
writeFileSync(join(root, "checksums.json"), JSON.stringify(manifest, null, 2) + "\n");
' "$backup_dir"
echo "Backup created: $backup_dir"
