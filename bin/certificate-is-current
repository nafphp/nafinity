#!/usr/bin/env python3
"""Whether the installed certificate is still usable, and issued by a given CA.

Exits 0 when it is, so a Makefile can skip reissuing. The three things that
matter are the same ones bin/generate-certificates checks -- it chains to the
authority we mean, it is not about to expire, and the private key beside it
belongs to it. A certificate failing any of them has to be replaced, and the
point of asking about the authority is that a certificate from some *other* CA
is exactly the case that looks fine and is not.
"""
import subprocess
import sys
from pathlib import Path

if len(sys.argv) < 2:
    sys.exit("Usage: certificate-is-current <ca.pem>")

authority = Path(sys.argv[1])
ssl = Path(__file__).resolve().parents[1] / "docker/rootfs/etc/nginx/ssl"
certificate = ssl / "fullchain.pem"
key = ssl / "privkey.pem"

if not (authority.is_file() and certificate.is_file() and key.is_file()):
    sys.exit(1)


def openssl(*arguments):
    return subprocess.run(
        ["openssl", *[str(a) for a in arguments]],
        check=True,
        capture_output=True,
        text=True,
    ).stdout


try:
    openssl("verify", "-CAfile", authority, certificate)
    openssl("x509", "-in", certificate, "-checkend", "86400", "-noout")
    if openssl("x509", "-in", certificate, "-pubkey", "-noout") != openssl(
        "pkey", "-in", key, "-pubout"
    ):
        sys.exit(1)
except subprocess.CalledProcessError:
    sys.exit(1)

sys.exit(0)
