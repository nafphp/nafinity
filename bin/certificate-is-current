#!/usr/bin/env node
/**
 * Whether the installed certificate is still usable, and issued by a given CA.
 *
 * Exits 0 when it is, so a Makefile can skip reissuing. The three things that
 * matter are the same ones bin/generate-certificates checks -- it chains to the
 * authority we mean, it is not about to expire, and the private key beside it
 * belongs to it. A certificate failing any of them has to be replaced, and the
 * point of asking about the authority is that a certificate from some *other* CA
 * is exactly the case that looks fine and is not.
 */
import { execFileSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const [authority] = process.argv.slice(2);
if (!authority) {
  console.error('Usage: certificate-is-current <ca.pem>');
  process.exit(2);
}

const ssl = join(dirname(dirname(fileURLToPath(import.meta.url))), 'docker/rootfs/etc/nginx/ssl');
const certificate = join(ssl, 'fullchain.pem');
const key = join(ssl, 'privkey.pem');

if (![authority, certificate, key].every((file) => existsSync(file))) process.exit(1);

// Quiet: the Makefile asks this inside an `if`, where openssl explaining that a
// certificate is not current would read as an error rather than as the answer.
const openssl = (...args) =>
  execFileSync('openssl', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });

try {
  openssl('verify', '-CAfile', authority, certificate);
  openssl('x509', '-in', certificate, '-checkend', '86400', '-noout');
  if (
    openssl('x509', '-in', certificate, '-pubkey', '-noout') !== openssl('pkey', '-in', key, '-pubout')
  )
    process.exit(1);
} catch {
  process.exit(1);
}

process.exit(0);
