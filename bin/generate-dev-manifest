#!/usr/bin/env node
/**
 * Write app/composer.dev.json: the installation's manifest, with every NAF
 * package it needs installed from its working copy instead of Packagist.
 *
 * A package counts when the installation needs it, directly or through another
 * working copy, and its checkout exists under NAF_SOURCE_ROOT. Its alias is the
 * highest lower bound any of them asks for, as a development version, so the
 * working copy satisfies all of them. The aliases never reach app/composer.json,
 * which describes a real installation.
 */
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = dirname(dirname(fileURLToPath(import.meta.url)));
const sources = resolve(root, process.env.NAF_SOURCE_ROOT || '../nafphp');
const manifest = JSON.parse(readFileSync(join(root, 'app/composer.json'), 'utf8'));

const read = (folder) => JSON.parse(readFileSync(join(sources, folder, 'composer.json'), 'utf8'));
const folderOf = (name) => (name.startsWith('naf/') ? name.slice(4) : null);
const present = (name) => folderOf(name) !== null && existsSync(join(sources, folderOf(name), 'composer.json'));

// The lowest version a constraint accepts, e.g. "^0.2.3" -> [0, 2, 3].
const floor = (constraint) => (constraint.match(/\d+(\.\d+)*/)?.[0] ?? '0').split('.').map(Number);
const higher = (left, right) => {
  for (let i = 0; i < Math.max(left.length, right.length); i++) {
    if ((left[i] ?? 0) !== (right[i] ?? 0)) return (left[i] ?? 0) > (right[i] ?? 0) ? left : right;
  }

  return left;
};

// Every NAF package the installation needs, following requirements through the
// working copies themselves, each with the highest floor anybody asks for --
// the alias has to satisfy all of them at once.
const floors = new Map();
const queue = Object.entries(manifest.require);
while (queue.length > 0) {
  const [name, constraint] = queue.shift();
  if (!present(name)) continue;

  const seen = floors.has(name);
  floors.set(name, seen ? higher(floors.get(name), floor(constraint)) : floor(constraint));
  if (!seen) queue.push(...Object.entries(read(folderOf(name)).require ?? {}));
}

manifest.repositories = [...floors].map(([name, version]) => ({
  type: 'path',
  // Relative to app/ inside the container, where compose.dev.yaml mounts the sources.
  url: `../nafphp/${folderOf(name)}`,
  options: { symlink: true, versions: { [name]: `${version.join('.')}-dev` } },
}));

manifest['minimum-stability'] = 'dev';
manifest['prefer-stable'] = true;

writeFileSync(join(root, 'app/composer.dev.json'), `${JSON.stringify(manifest, null, 2)}\n`);
console.log(
  `composer.dev.json written with ${manifest.repositories.length} working copies: `
  + manifest.repositories.map((repository) => Object.keys(repository.options.versions)[0]).join(', '),
);
