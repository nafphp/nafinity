#!/usr/bin/env node
/**
 * Resolve the board and the packages under review from their mounted sources.
 * Other dependencies use the published Composer constraints. The source aliases
 * are explicitly development versions and never enter the installation manifest.
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = dirname(dirname(fileURLToPath(import.meta.url)));
const manifest = JSON.parse(readFileSync(join(root, 'app/composer.json'), 'utf8'));

// What the board pulls in, so a local package it depends on is resolved too:
// the installation asks for naf/board, and naf/board asks for naf/rbac.
const boardRoot = process.env.NAF_BOARD_ROOT ?? '../nafphp/board';
const boardRequires = JSON.parse(
  readFileSync(resolve(root, boardRoot, 'composer.json'), 'utf8'),
).require;

// Relative to app/ inside the container; compose mounts these working copies.
const local = {
  'naf/board': '../board',
  'naf/database': '../nafphp/database',
  'naf/rbac': '../nafphp/rbac',
  'naf/websocket': '../nafphp/websocket',
};

manifest.repositories = [];
for (const [name, url] of Object.entries(local)) {
  const wanted = manifest.require[name] ?? boardRequires[name];
  if (!wanted) continue;

  manifest.repositories.push({
    type: 'path',
    url,
    options: { symlink: true, versions: { [name]: `${wanted.replace(/^\^/, '')}-dev` } },
  });
}

manifest['minimum-stability'] = 'dev';
manifest['prefer-stable'] = true;

writeFileSync(join(root, 'app/composer.dev.json'), `${JSON.stringify(manifest, null, 2)}\n`);
console.log(
  'composer.dev.json written with path repositories for '
  + manifest.repositories.map((repository) => Object.keys(repository.options.versions)[0]).join(', '),
);
