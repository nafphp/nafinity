#!/usr/bin/env node
/**
 * Create the private local Compose environment without replacing existing settings.
 */
import { randomBytes } from 'node:crypto';
import { closeSync, openSync, readFileSync, writeSync, constants } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = dirname(dirname(fileURLToPath(import.meta.url)));

/**
 * Write a file only if it is not there, and never overwrite local settings.
 *
 * Exclusive creation rather than "does it exist": between the question and the
 * answer somebody else may have created it, and this file holds passwords.
 */
function create(target, contents, made, kept) {
  let handle;
  try {
    handle = openSync(target, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL, 0o600);
  } catch (error) {
    if (error.code !== 'EEXIST') throw error;
    console.log(kept);

    return;
  }
  try {
    writeSync(handle, contents);
  } finally {
    closeSync(handle);
  }
  console.log(made);
}

// The project environment: what Compose needs to bring the services up.
const template = readFileSync(join(root, '.env.example'), 'utf8')
  .replace('replace-with-a-local-password', randomBytes(24).toString('hex'))
  .replace('replace-with-a-different-local-password', randomBytes(24).toString('hex'));

create(
  join(root, '.env'),
  template,
  'Created private .env with random database passwords for local development.',
  'Existing .env retained.',
);

// The application environment, which NAF reads from BASE_PATH. Compose still
// wins over it, so this is what matters where there is no Compose.
create(
  join(root, 'app/.env'),
  readFileSync(join(root, 'app/.env.example'), 'utf8'),
  'Created app/.env for the application itself.',
  'Existing app/.env retained.',
);
