#!/usr/bin/env node
/**
 * Install, check or apply the pinned php-cs-fixer for this installation's own PHP.
 *
 * Only what lives under app/: naf/board and the other packages carry their own
 * formatters and are checked in their repositories.
 */
import { execFileSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = dirname(dirname(fileURLToPath(import.meta.url)));
const phpTools = '/var/project/tools/style/php';

const action = process.argv[2] ?? 'check';
if (!['install', 'check', 'fix'].includes(action)) {
  console.error('Usage: style [install|check|fix]');
  process.exit(2);
}

const run = (command, args) => execFileSync(command, args, { cwd: root, stdio: 'inherit' });

const container = (...command) =>
  run('docker', [
    'compose', 'run', '--rm', '--no-deps',
    '--volume', `${root}:/var/project`,
    'app', ...command,
  ]);

if (action === 'install') {
  container('composer', `--working-dir=${phpTools}`, 'install', '--no-interaction', '--no-progress');
  process.exit(0);
}

if (!existsSync(join(root, 'tools/style/php/vendor/bin/php-cs-fixer'))) {
  console.error('Install the pinned formatter first: bin/style install');
  process.exit(2);
}

const check = action === 'check';

container(
  'php', `${phpTools}/vendor/bin/php-cs-fixer`, 'fix',
  '--config=/var/project/.php-cs-fixer.dist.php', '--sequential', '--show-progress=none',
  ...(check ? ['--dry-run', '--diff'] : []),
);
