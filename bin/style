#!/usr/bin/env python3
"""Install, check or apply the project's pinned development formatters."""

import argparse
import os
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
# The board is a dependency with its own code, its own style configuration and no
# container of its own. This is the container, so both are formatted from here --
# the host's own files and the package it installs.
board = Path(os.environ.get("BOARD_ROOT", root.parent / "board"))
tooling = root / "tools/style"
php_tools = "/workspace/project/tools/style/php"
web_tools = tooling / "web"
python_tools = tooling / "python"
python = python_tools / ".venv/bin/python"


def run(*command, cwd=None):
    subprocess.run([str(argument) for argument in command], cwd=cwd or root, check=True)


def container(*command):
    run(
        "docker",
        "compose",
        "run",
        "--rm",
        "--no-deps",
        "--volume",
        f"{root}:/workspace/project",
        "--volume",
        f"{board.resolve()}:/workspace/board",
        "app",
        *command,
    )


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("action", choices=["install", "check", "fix"], default="check", nargs="?")
args = parser.parse_args()

if args.action == "install":
    container(
        "composer", f"--working-dir={php_tools}", "install", "--no-interaction", "--no-progress"
    )
    run("npm", "ci", "--prefix", web_tools, "--ignore-scripts")
    run(sys.executable, "-m", "venv", python_tools / ".venv")
    run(python, "-m", "pip", "install", "-r", python_tools / "requirements.txt")
    sys.exit(0)

required = [
    tooling / "php/vendor/bin/php-cs-fixer",
    web_tools / "node_modules/prettier/bin/prettier.cjs",
    python,
]
if not all(path.exists() for path in required):
    parser.error("Install the pinned formatters first: bin/style install")

check = args.action == "check"
php_options = ["--dry-run", "--diff"] if check else []
for config in (
    "/workspace/project/.php-cs-fixer.dist.php",
    "/workspace/board/.php-cs-fixer.dist.php",
):
    container(
        "php",
        f"{php_tools}/vendor/bin/php-cs-fixer",
        "fix",
        f"--config={config}",
        "--sequential",
        "--show-progress=none",
        *php_options,
    )
# From the package's own directory, so its .prettierignore applies. It excludes
# the vendored libraries under public/assets/vendor, and an ignore file only ever
# matches paths relative to where the formatter runs.
run(
    "node",
    required[1],
    "--check" if check else "--write",
    "src/Resources/public/assets/**/*.js",
    "src/Resources/public/assets/**/*.css",
    "tests/*.mjs",
    cwd=board,
)

python_files = sorted((board / "tests").glob("*.py"))
python_files += sorted(
    path
    for path in (root / "bin").iterdir()
    if path.is_file()
    and (path.suffix == ".py" or path.read_text().startswith("#!/usr/bin/env python3"))
)
run(
    python,
    "-m",
    "black",
    "--line-length=100",
    *(["--check", "--diff"] if check else []),
    *python_files,
)
