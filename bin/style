#!/usr/bin/env node
/**
 * Install, check or apply the project's pinned development formatters.
 *
 * Two languages, two formatters: php-cs-fixer for PHP and Prettier for the
 * JavaScript and CSS the board ships. Both are pinned, and both run over this
 * project *and* over naf/board -- the board is a dependency with its own code,
 * its own style configuration and no container of its own. This is the
 * container, so both are formatted from here.
 */
import { execFileSync } from 'node:child_process';
import { existsSync, realpathSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = dirname(dirname(fileURLToPath(import.meta.url)));
const board = realpathSync(process.env.BOARD_ROOT ?? join(root, '../nafphp/board'));
// Not /var/board: compose mounts the package there read-only, which is
// right for serving it and wrong for a formatter. A path of its own is
// writable, and the package's config resolves through __DIR__ either way.
const BOARD_IN_CONTAINER = '/var/format-board';
const tooling = join(root, 'tools/style');
const phpTools = '/var/project/tools/style/php';
const webTools = join(tooling, 'web');

const action = process.argv[2] ?? 'check';
if (!['install', 'check', 'fix'].includes(action)) {
  console.error('Usage: style [install|check|fix]');
  process.exit(2);
}

const run = (command, args, options = {}) =>
  execFileSync(command, args, { cwd: root, stdio: 'inherit', ...options });

const container = (...command) =>
  run('docker', [
    'compose', 'run', '--rm', '--no-deps',
    '--volume', `${root}:/var/project`,
    '--volume', `${board}:${BOARD_IN_CONTAINER}`,
    'app', ...command,
  ]);

if (action === 'install') {
  container('composer', `--working-dir=${phpTools}`, 'install', '--no-interaction', '--no-progress');
  run('npm', ['ci', '--prefix', webTools, '--ignore-scripts']);
  process.exit(0);
}

const required = [
  join(tooling, 'php/vendor/bin/php-cs-fixer'),
  join(webTools, 'node_modules/prettier/bin/prettier.cjs'),
];
if (!required.every((path) => existsSync(path))) {
  console.error('Install the pinned formatters first: bin/style install');
  process.exit(2);
}

const check = action === 'check';

for (const config of [
  '/var/project/.php-cs-fixer.dist.php',
  `${BOARD_IN_CONTAINER}/.php-cs-fixer.dist.php`,
]) {
  container(
    'php', `${phpTools}/vendor/bin/php-cs-fixer`, 'fix',
    `--config=${config}`, '--sequential', '--show-progress=none',
    ...(check ? ['--dry-run', '--diff'] : []),
  );
}

// From the package's own directory, so its .prettierignore applies. It excludes
// the vendored libraries under src/Resources/public/assets/vendor, and an ignore
// file only ever matches paths relative to where the formatter runs.
run(
  'node',
  [
    required[1],
    check ? '--check' : '--write',
    'src/Resources/public/assets/**/*.js',
    'src/Resources/public/assets/**/*.css',
    'tests/js/*.test.js',
    'tests/benchmarks/*.mjs',
  ],
  { cwd: board },
);
