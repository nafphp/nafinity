#!/bin/sh
set -eu
umask 077
cd "$(dirname "$0")/.."
restore_backup="${1:?Pass the backup directory}"
# Never accept a destination argument: this is always a disposable isolated DB.
# Before anything is restored: the parts have to be the ones that were written.
node -e '
const { createHash } = require("node:crypto");
const { readFileSync } = require("node:fs");
const { join } = require("node:path");
const root = process.argv[1];
const expected = JSON.parse(readFileSync(join(root, "checksums.json"), "utf8"));
for (const [name, digest] of Object.entries(expected)) {
  if (!["database.sql", "storage.tar.gz"].includes(name)) {
    throw new Error("Unexpected entry in the manifest: " + name);
  }
  if (createHash("sha256").update(readFileSync(join(root, name))).digest("hex") !== digest) {
    throw new Error(name + " checksum mismatch");
  }
}
' "$restore_backup"
docker compose exec -T db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb -uroot -e "DROP DATABASE IF EXISTS nafinity_restore_test; CREATE DATABASE nafinity_restore_test;"'
docker compose exec -T db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb -uroot nafinity_restore_test' < "$restore_backup/database.sql"
restore_files=$(mktemp -d "${TMPDIR:-/tmp}/nafinity-restore.XXXXXX")
trap 'rm -rf "$restore_files"' EXIT HUP INT TERM
tar -xzf "$restore_backup/storage.tar.gz" -C "$restore_files"
docker compose exec -T db sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb -uroot -N -e "SELECT TABLE_NAME FROM information_schema.tables WHERE TABLE_SCHEMA=\"nafinity_restore_test\" ORDER BY TABLE_NAME; SELECT COUNT(*) FROM nafinity_restore_test.users; SELECT COUNT(*) FROM nafinity_restore_test.tickets; SELECT COUNT(*) FROM nafinity_restore_test.migrations;"'
# Every restored file, byte for byte against the one it came from.
node -e '
const { createHash } = require("node:crypto");
const { readFileSync, readdirSync } = require("node:fs");
const { join } = require("node:path");

const digestsUnder = (directory, prefix = "") => {
  const found = {};
  let entries;
  try {
    entries = readdirSync(directory, { withFileTypes: true });
  } catch {
    return found;
  }
  for (const entry of entries) {
    const name = prefix === "" ? entry.name : prefix + "/" + entry.name;
    if (entry.isDirectory()) Object.assign(found, digestsUnder(join(directory, entry.name), name));
    else if (entry.isFile()) {
      found[name] = createHash("sha256").update(readFileSync(join(directory, entry.name))).digest("hex");
    }
  }
  return found;
};

const original = digestsUnder("app/storage/attachments");
const restored = digestsUnder(join(process.argv[1], "storage/attachments"));
const same = JSON.stringify(Object.entries(original).sort()) === JSON.stringify(Object.entries(restored).sort());
if (!same) {
  throw new Error(
    "Attachment snapshot differs from current files; rerun with writers stopped"
      + " or verify against a backup-time manifest.",
  );
}
console.log("Restored attachment hashes match:", Object.keys(restored).length, "files");
' "$restore_files"
echo 'Restore probe completed in nafinity_restore_test; the running application was not overwritten.'
